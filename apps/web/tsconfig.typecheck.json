{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "paths": {
      "$lib": ["./src/lib"],
      "$lib/*": ["./src/lib/*"],
      "$app/types": ["./.svelte-kit/types/index.d.ts"],
      "#lib": ["./src/lib/index.js"],
      "#lib/*": ["./src/lib/*"]
    }
  },
  "exclude": [
    "src/service-worker.ts",
    "src/**/*.test.ts",
    "src/**/*.spec.ts",
    "src/**/__tests__/**",
    "src/**/__mocks__/**"
  ]
}
