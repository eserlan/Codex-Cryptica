# Repo-tooling secrets (not read by the Vite app in apps/web).

# Webhook URL for a Discord channel where the review-and-fix agent posts
# status updates and clarification requests. Create one via Discord:
# Server Settings -> Integrations -> Webhooks -> New Webhook -> Copy URL.
DISCORD_WEBHOOK_URL=

# Bluesky account used by scripts/post-to-bluesky.mjs (bsky-note skill).
# BLUESKY_IDENTIFIER is your handle or email; BLUESKY_APP_PASSWORD must be
# an app password (Settings -> App Passwords on bsky.app), never your main
# account password.
BLUESKY_IDENTIFIER=
BLUESKY_APP_PASSWORD=

# Cloudflare automation for scripts/update-bad-ips.ts (docs/cloudflare-bad-ip-automation.md).
# Token needs Account Rule Lists Edit + Zone Analytics Read. In GitHub
# Actions these live in repo secrets, not here.
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_BAD_IPS_TOKEN=
CLOUDFLARE_ZONE_ID=
# Optional enrichment / safety for the same script.
ABUSEIPDB_API_KEY=
GREYNOISE_API_KEY=
NEVER_BLOCK_CIDRS=
