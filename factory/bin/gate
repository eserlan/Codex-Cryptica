#!/usr/bin/env python3
"""The deterministic gate: does the job's branch pass the repo's checks?

Usage:
  gate <job-id>            write round-N/checks.md; exit 0 on PASS, 1 on FAIL
  gate <job-id> --merge    same, as round-N/merge-checks.md (job merge runs it)
  gate <job-id> --codex-sandbox  run checks with credentials and network isolated
  gate <job-id> --codex-sandbox --fallow-prechecked  skip Fallow after runner audit
  gate --hook              builder SubagentStop hook: run the checks once, exit 2 on failure

The gate runs the main checkout's factory/checks.sh inside the job's worktree,
so a branch can't change the checks it is judged by. It also fails when the
branch modifies or deletes a file matching config.json `protected_paths`
(fnmatch patterns, where `*` also matches `/`). Adding new files is fine.
"""

import fnmatch
import json
import subprocess
import sys
import time
from pathlib import Path

sys.path.insert(0, str(Path(__file__).resolve().parent))
from codex_sandbox import resolve_git_common_dir, run_sandboxed

REPO = Path(__file__).resolve().parents[2]
FACTORY = REPO / "factory"
CONFIG = json.loads((FACTORY / "config.json").read_text())
CHECKS = FACTORY / "checks.sh"
TAIL = 80


def die(msg):
    print(f"gate: {msg}", file=sys.stderr)
    sys.exit(2)


def git(worktree, *args):
    res = subprocess.run(["git", "-c", "core.hooksPath=/dev/null", *args], cwd=worktree,
                         capture_output=True, text=True)
    if res.returncode != 0:
        die(f"`git {' '.join(args)}` failed: {res.stderr.strip()}")
    return res.stdout


def protected_changes(worktree):
    """Existing files under protected_paths that the branch modified or deleted."""
    diff = git(worktree, "diff", "--no-ext-diff", "--no-textconv", "--name-status",
               f"origin/{CONFIG['base_branch']}...HEAD")
    hits = []
    for line in diff.splitlines():
        status, *paths = line.split("\t")
        if status.startswith("A"):
            continue
        old = paths[0]  # for renames and copies, the original path
        if any(fnmatch.fnmatch(old, pattern) for pattern in CONFIG["protected_paths"]):
            hits.append(f"{status[0]} {old}")
    return hits


def run_checks(worktree, codex_sandbox=False, bun_cache_dir=None, fallow_prechecked=False):
    start = time.monotonic()
    if codex_sandbox:
        res = run_sandboxed(
            ["bash", str(CHECKS)],
            cwd=worktree,
            writable_roots=[worktree],
            readable_roots=[CHECKS, FACTORY / "config.json"],
            git_common_dir=resolve_git_common_dir(REPO),
            bun_cache_dir=bun_cache_dir,
            fallow_prechecked=fallow_prechecked,
        )
    else:
        res = subprocess.run(["bash", str(CHECKS)], cwd=worktree, capture_output=True, text=True)
    return res.returncode, res.stdout + res.stderr, int(time.monotonic() - start)


def gate(job_id, merge, codex_sandbox=False, fallow_prechecked=False):
    job = json.loads((FACTORY / "jobs" / job_id / "job.json").read_text())
    worktree = job["worktree"]
    if job["round"] < 1:
        die(f"{job_id} hasn't started a build round")
    round_dir = FACTORY / "jobs" / job_id / f"round-{job['round']}"
    commit = git(worktree, "rev-parse", "HEAD").strip()
    protected = protected_changes(worktree)
    bun_cache_dir = FACTORY / "jobs" / job_id / "codex" / "bun-cache"
    code, log, seconds = run_checks(
        worktree,
        codex_sandbox=codex_sandbox,
        bun_cache_dir=bun_cache_dir if bun_cache_dir.is_dir() else None,
        fallow_prechecked=fallow_prechecked,
    )
    verdict = "PASS" if code == 0 and not protected else "FAIL"
    name = "merge-checks" if merge else "checks"
    (round_dir / f"{name}.log").write_text(log)
    tail = "\n".join(log.rstrip().splitlines()[-TAIL:])
    summary = [
        f"checks.sh {'passed' if code == 0 else f'failed with exit {code}'} in {seconds}s",
        f"Protected paths: {'changed: ' + ', '.join(protected) if protected else 'none changed'}",
        f"Commit {commit[:7]}" + (", synced with the latest main before merging" if merge else ""),
    ]
    (round_dir / f"{name}.md").write_text(
        f"GATE: {verdict}\nCOMMIT: {commit}\n\n"
        "## Summary\n" + "\n".join(f"- {s}" for s in summary) + "\n\n"
        "## Protected paths\n"
        + ("\n".join(f"- {p}" for p in protected) if protected else "None changed.")
        + f"\n\n## checks.sh\nExit {code} in {seconds}s. Last {TAIL} lines of {name}.log:\n\n```\n{tail}\n```\n"
    )
    print(f"GATE: {verdict} ({job_id} round {job['round']}, checks.sh exit {code} in {seconds}s"
          + (f", protected paths changed: {', '.join(protected)}" if protected else "") + ")")
    sys.exit(0 if verdict == "PASS" else 1)


def agy_hook(event):
    if event.get("continuationActive"):
        print(json.dumps({"decision": "allow"}))
        sys.exit(0)
    transcript = Path(event.get("transcriptPath", "")).expanduser()
    if not transcript.exists():
        print(json.dumps({"decision": "allow"}))
        sys.exit(0)
    prompt = ""
    try:
        with transcript.open() as f:
            for line in f:
                entry = json.loads(line)
                if entry.get("type") == "USER_INPUT":
                    prompt = entry.get("content") or ""
                    break
    except (OSError, ValueError):
        print(json.dumps({"decision": "allow"}))
        sys.exit(0)
    if "Job: " not in prompt or ("Agent: builder." not in prompt and "Build round " not in prompt):
        print(json.dumps({"decision": "allow"}))
        sys.exit(0)
    job_id = prompt.split("Job: ", 1)[1].split(".", 1)[0].strip()
    job_folder = FACTORY / "jobs" / job_id
    if "Job folder: " in prompt:
        folder_str = prompt.split("Job folder: ", 1)[1].split(". ", 1)[0].rstrip("/")
        if Path(folder_str).exists():
            job_folder = Path(folder_str)
    job_file = job_folder / "job.json"
    if not job_file.exists():
        print(json.dumps({"decision": "allow"}))
        sys.exit(0)
    build_md = job_folder / "build.md"
    if build_md.exists() and build_md.read_text().startswith("STATUS: BLOCKED"):
        print(json.dumps({"decision": "allow"}))
        sys.exit(0)
    job = json.loads(job_file.read_text())
    code, log, _ = run_checks(job["worktree"])
    if code != 0:
        tail = "\n".join(log.rstrip().splitlines()[-40:])
        reason = (f"factory/checks.sh fails in your worktree (exit {code}). The gate will reject this "
                  f"build. Fix it, or write STATUS: BLOCKED in build.md if you can't.\n\n{tail}")
        print(json.dumps({"decision": "continue", "reason": reason}))
        sys.exit(0)
    print(json.dumps({"decision": "allow"}))
    sys.exit(0)


def hook():
    event = json.load(sys.stdin)
    if "transcriptPath" in event or "hookEventName" in event:
        agy_hook(event)
    if event.get("stop_hook_active"):
        sys.exit(0)  # one nudge per stop; the gate decides
    with open(Path(event["agent_transcript_path"]).expanduser()) as f:
        content = json.loads(f.readline())["message"]["content"]
    prompt = content if isinstance(content, str) else " ".join(b.get("text", "") for b in content)
    job_id = prompt.split("Job: ", 1)[1].split(".", 1)[0]
    job = json.loads((FACTORY / "jobs" / job_id / "job.json").read_text())
    code, log, _ = run_checks(job["worktree"])
    if code != 0:
        tail = "\n".join(log.rstrip().splitlines()[-40:])
        print(f"factory/checks.sh fails in your worktree (exit {code}). The gate will reject this "
              f"build. Fix it, or write STATUS: BLOCKED in build.md if you can't.\n\n{tail}",
              file=sys.stderr)
        sys.exit(2)


def main(argv):
    if argv == ["--hook"]:
        hook()
    elif len(argv) == 1 and not argv[0].startswith("-"):
        gate(argv[0], merge=False)
    elif 1 <= len(argv) <= 4 and not argv[0].startswith("-"):
        options = argv[1:]
        allowed = {"--merge", "--codex-sandbox", "--fallow-prechecked"}
        if len(options) != len(set(options)) or set(options) - allowed:
            die(f"invalid gate option(s): {' '.join(options)}")
        codex_sandbox = "--codex-sandbox" in options
        fallow_prechecked = "--fallow-prechecked" in options
        if fallow_prechecked and not codex_sandbox:
            die("--fallow-prechecked requires --codex-sandbox")
        gate(argv[0], "--merge" in options, codex_sandbox, fallow_prechecked)
    else:
        die(__doc__.strip())


if __name__ == "__main__":
    main(sys.argv[1:])
